   "capStart": 27.655,
   "capEnd": 31.887
  },
  {
   "id": "lv3",
   "speaker": "narrator",
   "start": 31.937,
   "end": 35.267,
   "caption": "第三关：你来数<br>这里有几个<b>小星球</b>？",
   "capStart": 31.857,
   "capEnd": 38.417
  },
  {
   "id": "ans",
   "speaker": "narrator",
   "start": 38.467,
   "end": 40.633,

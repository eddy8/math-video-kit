 "lines": [
  {
   "id": "hook",
   "speaker": "doudou",
   "start": 0.6,
   "end": 4.508,
   "caption": "哇，好多亮晶晶的<b>星星</b>！<br>一共有几颗呀？",
   "capStart": 0.52,
   "capEnd": 4.908
  },
  {
   "id": "intro",
   "speaker": "narrator",
   "start": 4.958,
   "end": 7.971,
   "caption": "别急，我们闯三关<br>学会<b>数一数</b>！",
   "capStart": 4.878,
   "capEnd": 8.271
  },
  {
   "id": "lv1",
   "speaker": "narrator",
   "start": 8.321,
   "end": 10.264,
   "caption": "第一关：<b>一个一个</b>地数",
   "capStart": 8.241,
   "capEnd": 10.664
  },
  {
   "id": "cnt1",
   "speaker": "narrator",
   "start": 10.714,
   "end": 15.065,
   "caption": "数一个，点一个<br><b>1、2、3、4、5</b>",
   "capStart": 10.634,
   "capEnd": 15.315
  },
  {
   "id": "sum1",
   "speaker": "narrator",
   "start": 15.365,
   "end": 17.975,
   "caption": "最后数到 <b>5</b><br>就是一共有 <b>5</b> 颗",
   "capStart": 15.285,
   "capEnd": 18.375
  },
  {
   "id": "lv2",
   "speaker": "narrator",
   "start": 18.425,
   "end": 21.521,
   "caption": "第二关：<b>按顺序</b>数<br>不漏也不重",
   "capStart": 18.345,
   "capEnd": 21.771
  },
  {
   "id": "oops",
   "speaker": "doudou",
   "start": 21.821,
   "end": 24.496,

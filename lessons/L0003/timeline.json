 "lines": [
  {
   "id": "hook",
   "speaker": "doudou",
   "start": 0.6,
   "end": 4.508,
   "caption": "哇，好多亮晶晶的<b>星星</b>！<br>一共有几颗呀？",
   "capStart": 0.52,
   "capEnd": 4.908
  },
  {
   "id": "intro",
   "speaker": "narrator",
   "start": 4.958,
   "end": 8.025,
   "caption": "别急，我们闯三关<br>学会<b>数一数</b>！",
   "capStart": 4.878,
   "capEnd": 8.325
  },
  {
   "id": "lv1",
   "speaker": "narrator",
   "start": 8.375,
   "end": 10.337,
   "caption": "第一关：<b>一个一个</b>地数",
   "capStart": 8.295,
   "capEnd": 10.737
  },
  {
   "id": "cnt1",
   "speaker": "narrator",
   "start": 10.787,
   "end": 15.139,
   "caption": "数一个，点一个<br><b>1、2、3、4、5</b>",
   "capStart": 10.707,
   "capEnd": 15.389
  },
  {
   "id": "sum1",
   "speaker": "narrator",
   "start": 15.439,
   "end": 18.048,
   "caption": "最后数到 <b>5</b><br>就是一共有 <b>5</b> 颗",
   "capStart": 15.359,
   "capEnd": 18.448
  },
  {
   "id": "lv2",
   "speaker": "narrator",
   "start": 18.498,
   "end": 21.5,
   "caption": "第二关：<b>按顺序</b>数<br>不漏也不重",
   "capStart": 18.418,
   "capEnd": 21.75
  },
  {
   "id": "oops",
   "speaker": "doudou",
   "start": 21.8,
   "end": 24.474,

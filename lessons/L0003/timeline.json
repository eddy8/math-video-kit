   "capStart": 27.681,
   "capEnd": 31.913
  },
  {
   "id": "lv3",
   "speaker": "narrator",
   "start": 31.963,
   "end": 35.274,
   "caption": "第三关：你来数<br>这里有几个<b>小星球</b>？",
   "capStart": 31.883,
   "capEnd": 38.424
  },
  {
   "id": "ans",
   "speaker": "narrator",
   "start": 38.474,
   "end": 40.628,

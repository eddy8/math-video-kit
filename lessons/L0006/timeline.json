 "lines": [
  {
   "id": "hook",
   "speaker": "narrator",
   "start": 0.6,
   "end": 3.279,
   "caption": "皮球和积木，<b>哪个多</b>？",
   "capStart": 0.52,
   "capEnd": 3.679
  },
  {
   "id": "guess",
   "speaker": "doudou",
   "start": 3.729,
   "end": 6.293,
   "caption": "皮球排得长，<b>皮球多</b>！",
   "capStart": 3.649,
   "capEnd": 6.693
  },
  {
   "id": "doubt",
   "speaker": "narrator",
   "start": 6.743,
   "end": 9.762,
   "caption": "真的吗？<br>他<b>错在哪儿</b>？",
   "capStart": 6.663,
   "capEnd": 10.312
  },
  {
   "id": "pair",
   "speaker": "narrator",
   "start": 10.362,
   "end": 12.808,
   "caption": "不能看长短<br>要<b>一个对一个</b>",
   "capStart": 10.282,
   "capEnd": 13.208
  },
  {
   "id": "left",
   "speaker": "narrator",
   "start": 13.258,
   "end": 15.993,
   "caption": "积木还剩 1 个<br><b>积木比皮球多</b>",
   "capStart": 13.178,
   "capEnd": 16.393
  },
  {
   "id": "oops",
   "speaker": "doudou",
   "start": 16.443,
   "end": 19.189,
   "caption": "哎呀，我只看了长短<br><b>看错啦</b>！",
   "capStart": 16.363,
   "capEnd": 19.589
  },
  {
   "id": "count",
   "speaker": "doudou",
   "start": 19.639,
   "end": 22.418,
   "caption": "<b>4</b> 个积木，<b>3</b> 个皮球",
   "capStart": 19.559,
   "capEnd": 22.818
  },
  {
   "id": "gt",
   "speaker": "narrator",
   "start": 22.868,
   "end": 25.428,
   "caption": "4 比 3 多<br><b>4 &gt; 3</b>　4 大于 3",
   "capStart": 22.788,
   "capEnd": 25.828
  },
  {

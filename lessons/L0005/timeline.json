 "lines": [
  {
   "id": "hook",
   "speaker": "doudou",
   "start": 0.6,
   "end": 3.72,
   "caption": "超市好大呀！<br>我要的东西<b>在哪儿</b>呢？",
   "capStart": 0.52,
   "capEnd": 4.12
  },
  {
   "id": "intro",
   "speaker": "narrator",
   "start": 4.17,
   "end": 8.155,
   "caption": "说对<b>位置</b>就找得到！<br>快问快答，开始！",
   "capStart": 4.09,
   "capEnd": 8.455
  },
  {
   "id": "q1",
   "speaker": "narrator",
   "start": 8.505,
   "end": 11.032,
   "caption": "<b>苹果</b>在<b>橘子</b>的<br>上面还是下面？",
   "capStart": 8.425,
   "capEnd": 11.282
  },
  {
   "id": "a1",
   "speaker": "doudou",
   "start": 11.332,
   "end": 11.839,
   "caption": "<b>上面</b>！",
   "capStart": 11.252,
   "capEnd": 12.089
  },
  {
   "id": "r1",
   "speaker": "narrator",
   "start": 12.139,
   "end": 15.689,
   "caption": "对！反过来<br>橘子在苹果的<b>下面</b>",
   "capStart": 12.059,
   "capEnd": 16.089
  },
  {
   "id": "q2",
   "speaker": "narrator",
   "start": 16.139,
   "end": 19.802,
   "caption": "排队结账，豆豆在小鸡的<br><b>前面</b>还是<b>后面</b>？",
   "capStart": 16.059,
   "capEnd": 20.052
  },
  {
   "id": "a2",
   "speaker": "doudou",
   "start": 20.102,
   "end": 22.412,
   "caption": "<b>后面</b>！<br>小鸡在我<b>前面</b>",
   "capStart": 20.022,
   "capEnd": 22.662
  },
  {
   "id": "r2",
   "speaker": "narrator",
   "start": 22.712,
   "end": 25.919,
   "caption": "对啦！小鸡在<b>前</b><br>豆豆在<b>后</b>",
   "capStart": 22.632,
   "capEnd": 26.319
  },
  {
   "id": "q3",
   "speaker": "narrator",
   "start": 26.369,
   "end": 27.89,
   "caption": "<b>饼干</b>的<b>左边</b>是什么？",
   "capStart": 26.289,
   "capEnd": 28.14
  },
  {
   "id": "a3",
   "speaker": "doudou",
   "start": 28.19,
   "end": 28.982,
   "caption": "是<b>糖果</b>！",
   "capStart": 28.11,
   "capEnd": 29.232
  },
  {
   "id": "r3",
   "speaker": "narrator",
   "start": 29.282,
   "end": 33.784,
   "caption": "反啦！举起<b>左手</b><br>这边才是<b>左边</b>，是草莓",
   "capStart": 29.202,
   "capEnd": 34.184
  },
  {
   "id": "rule",
   "speaker": "narrator",
   "start": 34.234,
   "end": 37.496,
   "caption": "说位置，要说清<br><b>谁在谁的哪一边</b>",
   "capStart": 34.154,
   "capEnd": 37.896
  },
  {
   "id": "quiz",
   "speaker": "narrator",
   "start": 37.946,
   "end": 40.31,
   "caption": "练一练：<br><b>橘子</b>的<b>左边</b>是什么？",
   "capStart": 37.866,
   "capEnd": 43.46
  },
  {
   "id": "ans",
   "speaker": "narrator",
   "start": 43.51,
   "end": 45.901,
